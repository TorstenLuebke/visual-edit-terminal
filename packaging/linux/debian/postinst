#!/bin/sh
# ShellDeck – Debian/Ubuntu postinst
#
# Registriert ShellDeck als *auswaehlbare* x-terminal-emulator-Alternative.
# Das bisherige Standardterminal bleibt unveraendert; ShellDeck wird NICHT
# automatisch als Standard gesetzt. Idempotent: erneute Installation
# aktualisiert nur die vorhandene Registrierung.
set -e

LAUNCHER=/usr/bin/shelldeck
PRIORITY=40

if command -v update-alternatives >/dev/null 2>&1; then
    if [ -x "$LAUNCHER" ]; then
        update-alternatives --install /usr/bin/x-terminal-emulator \
            x-terminal-emulator "$LAUNCHER" "$PRIORITY" || true
    fi
fi

# Icon-/Desktop-Cache aktualisieren, falls Werkzeuge vorhanden sind.
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi

#DEBHELPER#
exit 0
